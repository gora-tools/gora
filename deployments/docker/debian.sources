# The Debian archive GORA's base image installs its packages from (TESTING rule 3): for each
# archive, one import of snapshot.debian.org, never the live archive. debian.lock pins the
# Release files it serves. A snapshot's Release files are past their Valid-Until by design;
# apt still checks their signatures with the keyring below.
Types: deb
URIs: https://snapshot.debian.org/archive/debian/20261109T145047Z/
Suites: trixie trixie-updates
Components: main
Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp
Check-Valid-Until: no

Types: deb
URIs: https://snapshot.debian.org/archive/debian-security/20261109T173309Z/
Suites: trixie-security
Components: main
Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp
Check-Valid-Until: no
