# GORA Configuration — copy to .env and fill in values.
# All variables use the GORA_ prefix (pydantic-settings env_prefix = "GORA_").

# --- GitHub ---
GORA_GITHUB_TOKEN=
GORA_GITHUB_ORG=zuwarskejes-labs

# --- Slack (ADR-015) — optional; leave disabled to run CLI-only ---
GORA_SLACK_ENABLED=false
# xoxb-… bot token (post messages + slash commands)
GORA_SLACK_BOT_TOKEN=
# xapp-… app-level token (Socket Mode, incoming commands — later)
GORA_SLACK_APP_TOKEN=
# verify HTTP-mode requests
GORA_SLACK_SIGNING_SECRET=
# default notification channel id (e.g. a dedicated #gora-releases)
GORA_SLACK_CHANNEL=

# --- GORA ---
GORA_LOG_LEVEL=INFO
GORA_MANIFEST_REPO=
