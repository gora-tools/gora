flowchart TD
    A["Developer tags v0.2.0-rc.1"] --> B["release.yml — on tag v*"]

    subgraph CI["CI — produces an immutable, attested artifact (ADR-011)"]
        B --> C["Build image"]
        C --> D["syft SBOM"]
        C --> E["cosign sign (keyless)"]
        C --> F["SLSA provenance"]
        D --> G[("Signed OCI artifact in GHCR<br/>image + SBOM + provenance @ digest")]
        E --> G
        F --> G
    end

    G -- "digest" --> H["gora cut-rc --image --version --digest"]
    H --> I["gora promote dev"]
    I --> J[["release-manifest.yaml committed in Git<br/>(single source of truth)"]]
    J --> K(("GORA released itself<br/>M3 exit ✓"))

    classDef gora fill:#1f6feb,stroke:#0b3d91,color:#fff;
    class H,I,J,K gora;
